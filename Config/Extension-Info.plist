<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>AI 邮件汇总与双语回复</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>AppleMailAIAppGroup</key>
    <string>$(DEVELOPMENT_TEAM).com.bao3.AppleMailAI</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>用于将邮件 AI 分析提取的待办事项一键添加到系统「提醒事项」，并设置截止日期与提前提醒。</string>
    <key>NSRemindersUsageDescription</key>
    <string>用于将邮件 AI 分析提取的待办事项一键添加到系统「提醒事项」。</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>用于通过 EventKit 将邮件待办事项写入系统提醒事项。</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>MEExtensionCapabilities</key>
            <array>
                <string>MEMessageSecurityHandler</string>
                <string>MEMessageActionHandler</string>
                <string>MEComposeSessionHandler</string>
            </array>
            <key>MEComposeSession</key>
            <dict>
                <key>MEComposeIcon</key>
                <string>ComposeToolbarIcon</string>
                <key>MEComposeIconToolTip</key>
                <string>AI 双语回复助手</string>
            </dict>
        </dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.email.extension</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).MailExtension</string>
    </dict>
</dict>
</plist>
